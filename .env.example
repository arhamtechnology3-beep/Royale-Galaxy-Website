# Server Configuration
PORT=5000

# Gmail SMTP Authentication Credentials
# GMAIL_USER must be the Gmail address sending the emails
GMAIL_USER=Royalegalaxysales@gmail.com

# GMAIL_APP_PASSWORD is the 16-character App Password generated from Google Account Security (2-Step Verification)
# Example: GMAIL_APP_PASSWORD=abcd1234efgh5678
GMAIL_APP_PASSWORD=

# Frontend API URL Configuration
VITE_API_URL=/api/send-lead

# Google Sheet lead capture (Google Apps Script Web App URL)
# Setup steps are in: leads-sheet/Code.gs
# Example: VITE_GOOGLE_SHEET_WEBHOOK=https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEET_WEBHOOK=
